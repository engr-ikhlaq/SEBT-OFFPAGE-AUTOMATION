# Copy to .env and fill in. Never commit .env.
SPREADSHEET_ID=
CREDENTIALS_PATH=Credentials.json
# Leave blank to use the first tab.
WORKSHEET_NAME=
SEEN_DB_PATH=seen_domains.db
MAX_PAGES=5
# 1 writes each confirmed lead to the sheet right away. Raise it to write in
# batches instead (fewer, larger API calls, but leads wait to be saved).
BATCH_SIZE=1
# How many of a site's contact pages are checked at once.
CRAWL_WORKERS=6
# Optional, comma-separated, e.g. .edu,.org,.ac.uk. Blank allows all domains.
ALLOWED_SUFFIXES=

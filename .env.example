# Copy this file to ".env" and fill in real values. NEVER commit the real .env file.
# Every value below is a placeholder — none of these are real credentials.

# --- SMTP settings ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
# Use a Gmail "App Password", NOT your normal login password.
# Create one at: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account)
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Sender identity ---
# Used for manual campaigns, and as the outreach fallback for anyone who
# hasn't connected their own Google account (see "Connect Google Account"
# below) — whoever is logged in and clicks "Send to new leads now" sends
# as themselves if they're connected, or as this identity if not.
FROM_NAME=Your Name
FROM_EMAIL=you@example.com
REPLY_TO_EMAIL=you@example.com

# --- App security ---
FLASK_SECRET_KEY=change-me-to-a-long-random-string
# Used ONCE, to create the first (owner) login account on first run — after
# that, the real password lives only as a hash in tracking.db, and changing
# these two values here does nothing. Manage accounts at /users once logged in.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me

# --- Connect Google Account (optional) ---
# Lets any logged-in user click "Connect Google Account" and send from their
# own Gmail (no app password) with their own auto-created lead sheet,
# instead of using the shared SMTP_* setup above. Leave both unset to hide
# the feature entirely — nothing else is affected.
# One-time setup in Google Cloud Console (same project as your other Google
# credentials, or a new one): APIs & Services > Credentials > Create
# Credentials > OAuth client ID > Application type "Web application" >
# Authorized redirect URI: http://localhost:5000/connect/google/callback
# (add your real domain too, later, if you deploy this). Also enable the
# Gmail API, Google Sheets API and Google Drive API on that project if they
# aren't already. See README.md for the full walkthrough.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Sending behaviour ---
# Seconds to wait between each individual email (throttling protects your sender reputation)
SEND_DELAY_SECONDS=3
# Gmail personal accounts: hard daily cap is ~500. Stay well under it.
MAX_EMAILS_PER_RUN=150
# Hours to wait with no reply before auto_outreach sends one follow-up.
FOLLOW_UP_AFTER_HOURS=24

# --- Tracking ---
# Public base URL recipients' mail clients can reach, used to build the
# open-pixel and click-redirect links embedded in emails. Leave this BLANK
# (the default) and it's inferred from each request's own Host header,
# which already works correctly for localhost, a tunnel (cloudflared/
# ngrok), or a real domain - no change needed as you move between them.
# Only set this explicitly if requests reach the app through something
# that rewrites the Host header (e.g. a reverse proxy), so the inferred
# value would be wrong.
PUBLIC_BASE_URL=

# --- Reply tracking (optional) ---
# Leave blank/unset to disable the "Check for replies" dashboard button.
# Gmail: same App Password as SMTP_PASSWORD works for IMAP too.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=you@example.com
IMAP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Google Sheets lead storage (optional — see data_source.py) ---
# Leave BOTH unset and scraped leads + outreach status are stored in a
# local leads.xlsx file automatically (see local_store.py) — no setup
# needed. Set these to switch to a Google Sheet instead; requires a
# SERVICE ACCOUNT json key (not an OAuth "Desktop" client) shared as
# Editor on the target sheet. See README.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=your-google-sheet-id-from-the-url
GOOGLE_WORKSHEET_NAME=Sheet1
# Only used when GOOGLE_SHEET_ID above is NOT set. Where the local Excel
# file lives.
LOCAL_LEADS_FILE=leads.xlsx

# --- Lead scraping (offpage package, triggered from Compose) ---
# Chrome always runs on THIS machine (wherever app.py is running), never
# on whoever's browser is viewing the Compose page - there's no way for a
# web request to open a window on the computer that sent it. Headless
# (the default) means no window appears for anyone; set to false to
# watch it locally while debugging selectors.
SCRAPE_HEADLESS=true
# Google result pages fetched per search query. Keep this low (1-2) for a
# web-triggered scrape - it's a real Chrome instance running for as long
# as it searches, and the page is waiting on it.
SCRAPE_MAX_PAGES=1
# Local SQLite file remembering which domains have already been checked,
# so re-running a keyword doesn't repeat work.
SEEN_DB_PATH=seen_domains.db
